{
  "mcpServers": {
    "kubernetes": {
      "type": "streamable-http",
      "url": "http://kubernetes-mcp-server:8080/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["pods_get", "pods_log", "events_list"],
      "healthCheck": { "url": "http://kubernetes-mcp-server:8080/healthz", "timeoutMs": 5000 },
      "timeoutMs": 5000,
      "description": "Kubernetes MCP — live pod status, events, and container logs from the cluster API",
      "tools": [
        {
          "name": "pods_get",
          "contextKey": "POD_STATUS",
          "description": "Current pod phase, container statuses, restart counts, and resource requests/limits.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}" }
        },
        {
          "name": "events_list",
          "contextKey": "POD_EVENTS",
          "description": "Kubernetes events for the pod (Type, Reason, Message, Timestamp).",
          "arguments": { "namespace": "${namespace}", "fieldSelector": "involvedObject.name=${podName}" }
        },
        {
          "name": "pods_log",
          "contextKey": "POD_LOGS",
          "description": "Current container logs, last 25 lines.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}", "container": "${containerName}", "previous": "false", "tailLines": "25" }
        },
        {
          "name": "pods_log",
          "contextKey": "POD_LOGS_PREVIOUS",
          "description": "Previous (crashed/restarted) container logs, last 25 lines.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}", "container": "${containerName}", "previous": "true", "tailLines": "25" }
        }
      ]
    },
    "quarkus": {
      "type": "streamable-http",
      "url": "http://mcp-metrics:8080/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["fetch_raw_metrics_from_endpoint"],
      "healthCheck": { "url": "http://mcp-metrics:8080/healthz", "timeoutMs": 10000 },
      "timeoutMs": 10000,
      "metadata": { "metricsBaseUrl": "http://mcp-metrics:8080/q/metrics" },
      "description": "Quarkus MCP — raw Prometheus-format metrics scraped from the target application's metrics endpoint",
      "tools": [
        {
          "name": "fetch_raw_metrics_from_endpoint",
          "contextKey": "QUARKUS_RAW_METRICS",
          "description": "Raw Prometheus-format metrics text scraped from the application's /q/metrics endpoint.",
          "arguments": { "pod_name": "${podName}", "namespace": "${namespace}", "baseUrl": "${metadata.metricsBaseUrl}" }
        }
      ]
    }
  }
}
